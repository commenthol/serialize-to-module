{
  "name": "serialize-to-module",
  "version": "2.0.0",
  "description": "serialize objects to node module",
  "keywords": [
    "javascript",
    "objects",
    "serialize"
  ],
  "homepage": "https://github.com/commenthol/serialize-to-module",
  "bugs": {
    "url": "https://github.com/commenthol/serialize-to-module/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/commenthol/serialize-to-module.git"
  },
  "license": "MIT",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": "commenthol <commenthol@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./lib/index.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "src",
    "types"
  ],
  "scripts": {
    "all": "npm run ci",
    "build": "rollup src/index.js --format cjs --exports default --file lib/index.cjs --external serialize-to-js,js-beautify",
    "ci": "npm run lint && npm test && npm run types && npm run build",
    "clean": "rimraf doc coverage .nyc_output node_modules *.tgz",
    "coverage": "nyc -r text -r html npm test",
    "format": "prettier --write README.md eslint.config.js src test lib",
    "lint": "eslint src test",
    "readme": "markedpp --githubid -i README.md -o README.md",
    "test": "mocha",
    "types": "tsc -p tsconfig.json"
  },
  "mocha": {
    "checkLeaks": true,
    "reporter": "spec"
  },
  "dependencies": {
    "js-beautify": "^2.0.3",
    "serialize-to-js": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12.17.0"
  }
}
